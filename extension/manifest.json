{
  "manifest_version": 3,
  "name": "Modu Focus Companion",
  "version": "0.1.0",
  "description": "An optional floating focus timer and website protection for Modu.",
  "permissions": [
    "storage",
    "alarms",
    "webNavigation",
    "declarativeNetRequestWithHostAccess",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://modu.howlil.site/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "blocked/index.html",
        "blocked/style.css",
        "blocked/blocked.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    },
    {
      "resources": [
        "floating/widget.css",
        "floating/modu-logo.svg"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "action": {
    "default_title": "Show Modu floating focus on this tab",
    "default_icon": {
      "48": "icons/modu-48.png"
    }
  },
  "icons": {
    "48": "icons/modu-48.png"
  }
}
