{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "modu-app",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-10-06",
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": false
    }
  },
  "ratelimits": [
    {
      "name": "FEATURE_REQUEST_IP_LIMITER",
      "namespace_id": "20261009",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "FEATURE_REQUEST_GLOBAL_LIMITER",
      "namespace_id": "20261010",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ]
}
