    "svelte": "^5.57.1",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.12",
    "vitest": "^4.0.0",
    "wrangler": "^4.148.0"
