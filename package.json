{
  "name": "modu-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.17.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "deploy": "pnpm build && wrangler pages deploy",
    "pages:dev": "pnpm build && wrangler pages dev",
    "pages:deploy": "pnpm build && wrangler pages deploy"
  },
  "dependencies": {
    "bits-ui": "^2.19.5",
    "dexie": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@sveltejs/adapter-cloudflare": "^8.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.12",
    "vitest": "^4.0.0",
    "wrangler": "^4.67.0"
  },
  "packageManager": "pnpm@10.11.1"
}
