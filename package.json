{
  "name": "modu-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.2.15",
  "engines": {
    "node": ">=22.17.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
