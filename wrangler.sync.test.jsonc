{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "modu-sync-runtime-integration",
  "main": "test/workers/sync-runtime-harness.ts",
  "compatibility_date": "2026-10-20",
  "exports": {
    "SyncSpace": { "type": "durable-object", "storage": "sqlite" }
  },
  "durable_objects": {
    "bindings": [
      { "name": "SYNC_SPACE", "class_name": "SyncSpace" }
    ]
  },
  "observability": { "enabled": false }
}
